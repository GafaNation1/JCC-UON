    <!-- Carousel Start -->
    <div class="container-fluid p-0 wow fadeIn" data-wow-delay="0.1s">
        <div class="owl-carousel header-carousel py-5">
            <div class="container py-5">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6">
                        <div class="carousel-text">
                            <h1 class="display-1 text-uppercase mb-3">Uniting Campus Christian Fellowships</h1>
                            <p class="fs-5 mb-5">JCC coordinates all Christian Union fellowships across University of Nairobi campuses, providing unified leadership, shared vision, and collective support for student ministry.</p>
                            <div class="d-flex">
                                <a class="btn btn-primary py-3 px-4 me-3" href="campuses.html">Find Your Campus CU</a>
                                <a class="btn btn-secondary py-3 px-4" href="about.html">Learn About JCC</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="carousel-img">
                            <img class="w-100" src="img/carousel-1.jpg" alt="Image">
                        </div>
                    </div>
                </div>
            </div>
            <div class="container py-5">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6">
                        <div class="carousel-text">
                            <h1 class="display-1 text-uppercase mb-3">Building Leaders Through Fellowship</h1>
                            <p class="fs-5 mb-5">We develop student leaders across all campuses through coordinated fellowships, shared resources, and unified vision for Christian campus ministry.</p>
                            <div class="d-flex mt-4">
                                <a class="btn btn-primary py-3 px-4 me-3" href="events.html">Upcoming Events</a>
                                <a class="btn btn-secondary py-3 px-4" href="leadership.html">Meet Our Leaders</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="carousel-img">
                            <img class="w-100" src="img/carousel-2.jpg" alt="Image">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Carousel End -->


    <!-- Video Start -->
    <div class="container-fluid bg-primary mb-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container">
            <div class="row g-0">
                <div class="col-lg-11">
                    <div class="h-100 py-5 d-flex align-items-center">
                        <button type="button" class="btn-play" data-bs-toggle="modal"
                            data-src="https://www.youtube.com/embed/DWRcNpR6Kdc" data-bs-target="#videoModal">
                            <span></span>
                        </button>
                        <h3 class="ms-5 mb-0">Together, we build strong Christian communities across all University of Nairobi campuses.</h3>
                    </div>
                </div>
                <div class="d-none d-lg-block col-lg-1">
                    <div class="h-100 w-100 bg-secondary d-flex align-items-center justify-content-center">
                        <span class="text-white" style="transform: rotate(-90deg);">Scroll Down</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Video End -->


    <!-- Video Modal Start -->
    <div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content rounded-0">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Youtube Video</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- 16:9 aspect ratio -->
                    <div class="ratio ratio-16x9">
                        <iframe class="embed-responsive-item" src="" id="video" allowfullscreen allowscriptaccess="always"
                            allow="autoplay"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Video Modal End -->


    <!-- About Start -->
    <div class="container-fluid py-5">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 wow fadeIn" data-wow-delay="0.2s">
                    <div class="about-img">
                        <img class="img-fluid w-100" src="img/about.jpg" alt="Image">
                    </div>
                </div>
                <div class="col-lg-6">
                    <p class="section-title bg-white text-start text-primary pe-3">About JCC</p>
                    <h1 class="display-6 mb-4 wow fadeIn" data-wow-delay="0.2s">Coordinating Campus Christian Unions</h1>
                    <p class="mb-4 wow fadeIn" data-wow-delay="0.3s">JCC serves as the central coordinating body for all Christian Union fellowships across University of Nairobi campuses, providing unified leadership, shared vision, and collective support for student ministry.</p>
                    <div class="row g-4 pt-2">
                        <div class="col-sm-6 wow fadeIn" data-wow-delay="0.4s">
                            <div class="h-100">
                                <h3>Our Role</h3>
                                <p>We coordinate all campus CUs under one unified structure while respecting each campus's unique identity and leadership.</p>
                                <p class="text-dark"><i class="fa fa-check text-primary me-2"></i>Unified leadership across campuses</p>
                                <p class="text-dark"><i class="fa fa-check text-primary me-2"></i>Shared vision and doctrine</p>
                                <p class="text-dark mb-0"><i class="fa fa-check text-primary me-2"></i>Collective events and fellowships</p>
                            </div>
                        </div>
                        <div class="col-sm-6 wow fadeIn" data-wow-delay="0.5s">
                            <div class="h-100 bg-primary p-4 text-center">
                                <p class="fs-5 text-dark">Join us in building strong Christian communities through coordinated campus ministry.</p>
                                <a class="btn btn-secondary py-2 px-4" href="about.html">Learn More About JCC</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- About End -->


    <!-- Features Start -->
    <div class="container-fluid py-5">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6">
                    <div class="rounded overflow-hidden">
                        <div class="row g-0">
                            <div class="col-sm-6 wow fadeIn" data-wow-delay="0.1s">
                                <div class="text-center bg-primary py-5 px-4 h-100">
                                    <i class="fa fa-university fa-3x text-secondary mb-3"></i>
                                    <h1 class="display-5 mb-0" data-toggle="counter-up">8</h1>
                                    <span class="text-dark">Active Campuses</span>
                                </div>
                            </div>
                            <div class="col-sm-6 wow fadeIn" data-wow-delay="0.3s">
                                <div class="text-center bg-secondary py-5 px-4 h-100">
                                    <i class="fa fa-users fa-3x text-primary mb-3"></i>
                                    <h1 class="display-5 text-white mb-0" data-toggle="counter-up">5000+</h1>
                                    <span class="text-white">Student Members</span>
                                </div>
                            </div>
                            <div class="col-sm-6 wow fadeIn" data-wow-delay="0.5s">
                                <div class="text-center bg-secondary py-5 px-4 h-100">
                                    <i class="fa fa-calendar fa-3x text-primary mb-3"></i> 
                                    <h1 class="display-5 text-white mb-0" data-toggle="counter-up">150+</h1>
                                    <span class="text-white">Annual Events</span>
                                </div>
                            </div>
                            <div class="col-sm-6 wow fadeIn" data-wow-delay="0.7s">
                                <div class="text-center bg-primary py-5 px-4 h-100">
                                    <i class="fa fa-church fa-3x text-secondary mb-3"></i>
                                    <h1 class="display-5 mb-0" data-toggle="counter-up">50+</h1>
                                    <span class="text-dark">Fellowship Groups</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <p class="section-title bg-white text-start text-primary pe-3">Why JCC?</p>
                    <h1 class="display-6 mb-4 wow fadeIn" data-wow-delay="0.2s">Why Students Choose JCC Coordination</h1>
                    <p class="mb-4 wow fadeIn" data-wow-delay="0.3s">JCC provides unified leadership, shared resources, and coordinated events while preserving each campus's unique identity and autonomy.</p>
                    <p class="text-dark wow fadeIn" data-wow-delay="0.4s"><i class="fa fa-check text-primary me-2"></i>Central coordination across all campuses</p>
                    <p class="text-dark wow fadeIn" data-wow-delay="0.5s"><i class="fa fa-check text-primary me-2"></i>Shared vision and doctrinal foundation</p>
                    <p class="text-dark wow fadeIn" data-wow-delay="0.6s"><i class="fa fa-check text-primary me-2"></i>Collective events and fellowships</p>
                    <div class="d-flex mt-4 wow fadeIn" data-wow-delay="0.7s">
                        <a class="btn btn-primary py-3 px-4 me-3" href="campuses.html">Find Your Campus CU</a>
                        <a class="btn btn-secondary py-3 px-4" href="about.html">Learn More About JCC</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Features End -->


    <!-- Campus CUs Start -->
    <div class="container-fluid py-5">
        <div class="container">
            <div class="text-center mx-auto wow fadeIn" data-wow-delay="0.1s" style="max-width: 560px;">
                <p class="section-title bg-white text-center text-primary px-3">Campuses</p>
                <h1 class="display-6 mb-2">JCC Coordinated Campus Fellowships</h1>
                <p class="text-muted mb-4">All 8 University of Nairobi campuses have an active Christian Union coordinated by JCC.</p>
            </div>

            <!-- First row — 3 campuses shown by default (alphabetical: Chiromo, Kenya Science, Kikuyu) -->
            <div class="row g-4">

                <!-- 1. Chiromo Campus CU -->
                <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.1s">
                    <div class="donation-item d-flex h-100 p-4">
                        <div class="donation-progress d-flex flex-column flex-shrink-0 text-center me-4">
                            <h6 class="mb-0">Faculty</h6>
                            <span class="mb-2" style="font-size:11px;">Sciences</span>
                            <div class="progress d-flex align-items-end w-100 h-100 mb-2">
                                <div class="progress-bar w-100 bg-secondary" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100">
                                    <span class="fs-4">80%</span>
                                </div>
                            </div>
                            <h6 class="mb-0">Active</h6>
                            <span style="font-size:11px;">Members</span>
                        </div>
                        <div class="donation-detail">
                            <div class="position-relative mb-4">
                                <img class="img-fluid w-100" src="img/campus service 2.webp" alt="Chiromo Campus CU">
                                <a href="campus-chiromo.html" class="btn btn-sm btn-secondary px-3 position-absolute top-0 end-0">Chiromo</a>
                            </div>
                            <a href="campus-chiromo.html" class="h3 d-inline-block">Chiromo Campus CU</a>
                            <p>Situated off Riverside Drive, serving students of Biological and Physical Sciences through fellowship and discipleship.</p>
                            <a href="campus-chiromo.html" class="btn btn-primary w-100 py-3"><i class="fa fa-arrow-right me-2"></i>Visit Campus CU</a>
                        </div>
                    </div>
                </div>

                <!-- 2. Kenya Science Campus CU -->
                <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.2s">
                    <div class="donation-item d-flex h-100 p-4">
                        <div class="donation-progress d-flex flex-column flex-shrink-0 text-center me-4">
                            <h6 class="mb-0">Faculty</h6>
                            <span class="mb-2" style="font-size:11px;">Science</span>
                            <div class="progress d-flex align-items-end w-100 h-100 mb-2">
                                <div class="progress-bar w-100 bg-secondary" role="progressbar" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100">
                                    <span class="fs-4">70%</span>
                                </div>
                            </div>
                            <h6 class="mb-0">Active</h6>
                            <span style="font-size:11px;">Members</span>
                        </div>
                        <div class="donation-detail">
                            <div class="position-relative mb-4">
                                <img class="img-fluid w-100" src="img/campus service.webp" alt="Kenya Science Campus CU">
                                <a href="campus-kenya-science.html" class="btn btn-sm btn-secondary px-3 position-absolute top-0 end-0">Kenya Science</a>
                            </div>
                            <a href="campus-kenya-science.html" class="h3 d-inline-block">Kenya Science Campus CU</a>
                            <p>Located along Ngong Road, a growing fellowship community committed to reaching students across the Science campus.</p>
                            <a href="campus-kenya-science.html" class="btn btn-primary w-100 py-3"><i class="fa fa-arrow-right me-2"></i>Visit Campus CU</a>
                        </div>
                    </div>
                </div>

                <!-- 3. Kikuyu Campus CU -->
                <div class="col-md-6 col-lg-4 wow fadeIn" data-wow-delay="0.3s">
                    <div class="donation-item d-flex h-100 p-4">
                        <div class="donation-progress d-flex flex-column flex-shrink-0 text-center me-4">
                            <h6 class="mb-0">Faculty</h6>
                            <span class="mb-2" style="font-size:11px;">CEES</span>
                            <div class="progress d-flex align-items-end w-100 h-100 mb-2">
                                <div class="progress-bar w-100 bg-secondary" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                                    <span class="fs-4">75%</span>
                                </div>
                            </div>
                            <h6 class="mb-0">Active</h6>
                            <span style="font-size:11px;">Members</span>
                        </div>
                        <div class="donation-detail">
                            <div class="position-relative mb-4">
                                <img class="img-fluid w-100" src="img/campus service 3.webp" alt="Kikuyu Campus CU">
                                <a href="campus-kikuyu.html" class="btn btn-sm btn-secondary px-3 position-absolute top-0 end-0">Kikuyu</a>
                            </div>
                            <a href="campus-kikuyu.html" class="h3 d-inline-block">Kikuyu Campus CU</a>
                            <p>Near Kikuyu Town, home to the College of Education and External Studies. A prayerful and outreach-focused CU community.</p>
                            <a href="campus-kikuyu.html" class="btn btn-primary w-100 py-3"><i class="fa fa-arrow-right me-2"></i>Visit Campus CU</a>
                        </div>
                    </div>
                </div>

            </div><!-- /first row -->

            <!-- View All CUs Button -->
            <div class="text-center mt-5 wow fadeIn" data-wow-delay="0.3s">
                <button class="btn btn-secondary py-3 px-5 fs-6" data-bs-toggle="modal" data-bs-target="#allCampusesModal">
                    <i class="fa fa-th-large me-2"></i>View All 8 Campus CUs
                </button>
            </div>

        </div>
    </div>
    <!-- Campus CUs End -->


    <!-- All Campuses Modal -->
    <div class="modal fade" id="allCampusesModal" tabindex="-1" aria-labelledby="allCampusesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content rounded-0">

                <!-- Modal Header -->
                <div class="modal-header" style="background-color:#0057A8; padding: 20px 30px;">
                    <div>
                        <h4 class="modal-title text-white mb-1" id="allCampusesModalLabel">
                            <i class="fa fa-university me-2" style="color:#C9A84C;"></i>All JCC Campus Christian Unions
                        </h4>
                        <p class="text-white mb-0" style="font-size:14px; opacity:.85;">8 active CUs across the University of Nairobi — listed alphabetically</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4" style="background-color:#F4F6FA;">
                    <div class="row g-4">

                        <!-- 1. Chiromo Campus CU -->
                        <div class="col-md-6 col-lg-3">
                            <div class="donation-item d-flex flex-column h-100 p-3 bg-white">
                                <div class="position-relative mb-3">
                                    <img class="img-fluid w-100" src="img/campus service 2.webp" alt="Chiromo Campus CU">
                                    <span class="btn btn-sm btn-secondary px-2 position-absolute top-0 end-0" style="font-size:11px;">Chiromo</span>
                                </div>
                                <h5 class="mb-1">Chiromo Campus CU</h5>
                                <p class="text-muted small mb-1"><i class="fa fa-map-marker-alt text-primary me-1"></i> Off Riverside Drive, Nairobi</p>
                                <p class="text-muted small mb-2"><i class="fa fa-graduation-cap text-primary me-1"></i> Biological &amp; Physical Sciences</p>
                                <p class="small mb-3">Serving science students through fellowship, Bible study, and outreach ministries on the Riverside Drive campus.</p>
                                <a href="campus-chiromo.html" class="btn btn-primary py-2 mt-auto"><i class="fa fa-arrow-right me-1"></i>View Campus CU</a>
                            </div>
                        </div>

                        <!-- 2. Kenya Science Campus CU -->
                        <div class="col-md-6 col-lg-3">
                            <div class="donation-item d-flex flex-column h-100 p-3 bg-white">
                                <div class="position-relative mb-3">
                                    <img class="img-fluid w-100" src="img/campus service.webp" alt="Kenya Science Campus CU">
                                    <span class="btn btn-sm btn-secondary px-2 position-absolute top-0 end-0" style="font-size:11px;">Kenya Science</span>
                                </div>
                                <h5 class="mb-1">Kenya Science Campus CU</h5>
                                <p class="text-muted small mb-1"><i class="fa fa-map-marker-alt text-primary me-1"></i> Ngong Road, Nairobi</p>
                                <p class="text-muted small mb-2"><i class="fa fa-graduation-cap text-primary me-1"></i> Science &amp; Technology</p>
                                <p class="small mb-3">A dedicated fellowship community along Ngong Road committed to growing in faith and serving the campus community.</p>
                                <a href="campus-kenya-science.html" class="btn btn-primary py-2 mt-auto"><i class="fa fa-arrow-right me-1"></i>View Campus CU</a>
                            </div>
                        </div>

                        <!-- 3. Kikuyu Campus CU -->
                        <div class="col-md-6 col-lg-3">
                            <div class="donation-item d-flex flex-column h-100 p-3 bg-white">
                                <div class="position-relative mb-3">
                                    <img class="img-fluid w-100" src="img/campus service 3.webp" alt="Kikuyu Campus CU">
                                    <span class="btn btn-sm btn-secondary px-2 position-absolute top-0 end-0" style="font-size:11px;">Kikuyu</span>
                                </div>
                                <h5 class="mb-1">Kikuyu Campus CU</h5>
